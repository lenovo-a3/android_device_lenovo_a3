# Android fstab for the Lenovo IdeaTab A3000-H, FUSE layout (cm-12.1).
# No FAT partition: internal storage is emulated in /data/media (sdcard service
# in init.mt8389.rc). Partitions per MT6589_Android_scatter_emmc.txt (FUSE):
#   p5 FAC, p6 ANDROID, p7 CACHE, p8 USRDATA.
# L fs_mgr can't resolve MTK's /emmc@<name> aliases, so mmcblk0pN is used.
# The filesystem holding e2fsck (/system) can't use "check" and must come first.
#
#<src>                 <mnt_point>  <type>  <mnt_flags and options>                                   <fs_mgr_flags>
/dev/block/mmcblk0p6   /system      ext4    ro,noatime                                                wait
/dev/block/mmcblk0p7   /cache       ext4    noatime,nosuid,nodev,noauto_da_alloc                      wait,check
/dev/block/mmcblk0p8   /data        ext4    noatime,nosuid,nodev,noauto_da_alloc                      wait,check,encryptable=footer
# PROTECT_F/PROTECT_S (p2/p3) are mounted by init.protect.rc, not here: any failed
# mount makes mount_all return -1, and then L init never triggers "nonencrypted"
# (no class main). They are optional, so they must not be able to block the boot.

# external microSD and USB OTG (vold)
/devices/platform/mtk-msdc.1/mmc_host/mmc1* auto  auto  nosuid,nodev  voldmanaged=sdcard1:auto
/devices/platform/mt_usb*                   auto  auto  nosuid,nodev  voldmanaged=usbdisk0:auto

# raw MTK dumchar partitions
/dev/bootimg           /boot        emmc    defaults                                                  defaults
/dev/recovery          /recovery    emmc    defaults                                                  defaults
/dev/misc              /misc        emmc    defaults                                                  defaults
